# Copy to config/deployment.env. Use 32-byte random hexadecimal values so
# passwords remain URL-safe. Use a secret manager outside this staging stack.
SAFEHARNESS_POSTGRES_ADMIN_PASSWORD=replace-postgres-admin-password
SAFEHARNESS_POSTGRES_MIGRATOR_PASSWORD=replace-migrator-password
SAFEHARNESS_POSTGRES_WRITER_PASSWORD=replace-writer-password
SAFEHARNESS_POSTGRES_READER_PASSWORD=replace-reader-password
SAFEHARNESS_POSTGRES_RETENTION_PASSWORD=replace-retention-password
SAFEHARNESS_REDIS_PASSWORD=replace-redis-admin-password
SAFEHARNESS_REDIS_GATEWAY_PASSWORD=replace-redis-gateway-password
SAFEHARNESS_REDIS_COMMUNICATION_PASSWORD=replace-redis-communication-password
SAFEHARNESS_GATEWAY_API_KEY=replace-with-at-least-32-random-characters
SAFEHARNESS_GATEWAY_SIGNING_KEY=replace-with-at-least-32-random-bytes
SAFEHARNESS_ENFORCEMENT_RECEIPT_SIGNING_KEY=replace-with-another-32-random-bytes
SAFEHARNESS_COMMUNICATION_SUPERVISOR_API_KEY=replace-with-distinct-supervisor-key-at-least-32-chars
SAFEHARNESS_COMMUNICATION_DIAGNOSIS_API_KEY=replace-with-distinct-diagnosis-key-at-least-32-chars
SAFEHARNESS_COMMUNICATION_COORDINATION_SIGNING_KEY=replace-with-independent-coordination-key-at-least-32-bytes
SAFEHARNESS_COMMUNICATION_ADMIN_API_KEY=replace-with-distinct-admin-key-at-least-32-chars
# Optional HTTPS append-only audit receiver. Leave both blank when disabled.
SAFEHARNESS_COMMUNICATION_AUDIT_EXPORT_URL=
SAFEHARNESS_COMMUNICATION_AUDIT_EXPORT_TOKEN=
# Optional shared mailbox/replay/lease backend (initialize with safeharness-communication-init).
# SAFEHARNESS_COMMUNICATION_BACKEND=postgres
# SAFEHARNESS_COMMUNICATION_POSTGRES_DSN=postgresql://safeharness_writer:password@postgres:5432/safeharness
# Optional shared coordination policy backend (initialize with safeharness-coordination-init).
# SAFEHARNESS_COMMUNICATION_COORDINATION_BACKEND=postgres
# SAFEHARNESS_COMMUNICATION_COORDINATION_POSTGRES_DSN=postgresql://coordination_writer:password@postgres:5432/safeharness
GRAFANA_ADMIN_PASSWORD=replace-grafana-admin-password
