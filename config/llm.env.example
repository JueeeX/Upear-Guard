# Copy this file to config/llm.env. It is ignored by Git.
# Replace the API-key placeholder before running against a real provider.

# Any OpenAI-compatible Chat Completions endpoint. Many providers require /v1.
SAFEHARNESS_LLM_BASE_URL=https://api.openai.com/v1
SAFEHARNESS_LLM_API_KEY=replace-with-your-api-key
SAFEHARNESS_LLM_MODEL=gpt-4o-mini

# Optional: a separate model for LLM-as-Judge evaluation. Leave blank to reuse
# SAFEHARNESS_LLM_MODEL.
SAFEHARNESS_JUDGE_MODEL=

# Enable the optional semantic prompt-injection and tool-intent checks.
SAFEHARNESS_ENABLE_SEMANTIC_JUDGE=true
