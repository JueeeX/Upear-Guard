# Copy this file to config/admin-ui.env, then replace both placeholder secrets.
# The file is read only by safeharness-admin-ui and is ignored by Git.

# Keep the console local by default.
SAFEHARNESS_ADMIN_UI_HOST=127.0.0.1
SAFEHARNESS_ADMIN_UI_PORT=38308

# Base URL only: do not append /v1/admin. The console adds its allowlisted API paths.
SAFEHARNESS_ADMIN_UI_UPSTREAM_URL=http://127.0.0.1:38200

# This is the coordination admin key, not an Agent API key. Use at least 32 random characters.
SAFEHARNESS_ADMIN_UI_ADMIN_KEY=replace-with-the-coordination-admin-key-at-least-32-chars

# Separate browser-session token. Use at least 32 random characters.
SAFEHARNESS_ADMIN_UI_ACCESS_TOKEN=replace-with-a-different-browser-token-at-least-32-chars

# Server-to-server mutation key. Never expose this key to the browser recovery console.
SAFEHARNESS_ADMIN_UI_MUTATION_KEY=replace-with-a-third-server-mutation-key-at-least-32-chars

# Optional read-only SafeHarness SQLite audit source; leave blank to disable the audit query.
SAFEHARNESS_ADMIN_UI_AUDIT_DATABASE=

# Upstream request timeout, in seconds (1-30).
SAFEHARNESS_ADMIN_UI_TIMEOUT_SECONDS=5
