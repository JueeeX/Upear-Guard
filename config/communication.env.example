# Standalone Agent Communication Gateway reference configuration.
# Copy to config/communication.env and replace the current keys with independent secrets.
SAFEHARNESS_COMMUNICATION_GATEWAY_HOST=127.0.0.1
SAFEHARNESS_COMMUNICATION_GATEWAY_PORT=38200
SAFEHARNESS_COMMUNICATION_GATEWAY_URL=http://127.0.0.1:38200
SAFEHARNESS_COMMUNICATION_DATABASE=data/agent-communication.sqlite3
# SQLite is the local mailbox default. For shared mailbox/replay/lease state,
# initialize PostgreSQL with safeharness-communication-init, then set:
SAFEHARNESS_COMMUNICATION_BACKEND=sqlite
# SAFEHARNESS_COMMUNICATION_POSTGRES_DSN=postgresql://communication-writer:password@db/safeharness
# Never enable schema initialization on a normal runtime identity. It is only a
# local-development escape hatch; production migrations use the init command.
SAFEHARNESS_COMMUNICATION_POSTGRES_INITIALIZE=false
# Separate HMAC key for signed coordination policy state; never reuse an Agent API key.
SAFEHARNESS_COMMUNICATION_COORDINATION_SIGNING_KEY=replace-with-independent-coordination-key-at-least-32-bytes
# SQLite is the local default. For shared policy state, initialize PostgreSQL first with
# safeharness-coordination-init, then set both variables below.
SAFEHARNESS_COMMUNICATION_COORDINATION_BACKEND=sqlite
# SAFEHARNESS_COMMUNICATION_COORDINATION_POSTGRES_DSN=postgresql://coordination-writer:password@db/safeharness

SAFEHARNESS_COMMUNICATION_TENANT_ID=fiberhome-demo
SAFEHARNESS_COMMUNICATION_SUPERVISOR_AGENT_ID=noc-supervisor-agent
SAFEHARNESS_COMMUNICATION_DIAGNOSIS_AGENT_ID=noc-diagnosis-agent
SAFEHARNESS_COMMUNICATION_SUPERVISOR_API_KEY=replace-with-distinct-supervisor-key-at-least-32-chars
SAFEHARNESS_COMMUNICATION_DIAGNOSIS_API_KEY=replace-with-distinct-diagnosis-key-at-least-32-chars
# Set an old key only during a bounded rotation window; clear it after clients switch.
SAFEHARNESS_COMMUNICATION_SUPERVISOR_PREVIOUS_API_KEY=
SAFEHARNESS_COMMUNICATION_DIAGNOSIS_PREVIOUS_API_KEY=
SAFEHARNESS_COMMUNICATION_ADMIN_ACTOR=noc-security-admin
SAFEHARNESS_COMMUNICATION_ADMIN_API_KEY=replace-with-distinct-admin-key-at-least-32-chars
SAFEHARNESS_COMMUNICATION_ADMIN_PREVIOUS_API_KEY=

# The trusted delegation is bound to this session and run.
SAFEHARNESS_COMMUNICATION_SESSION_ID=noc-multi-agent-session
SAFEHARNESS_COMMUNICATION_RUN_ID=noc-multi-agent-run
SAFEHARNESS_COMMUNICATION_DELEGATION_ID=noc-read-only-diagnosis
SAFEHARNESS_COMMUNICATION_DELEGATION_MAX_MESSAGES=1000
SAFEHARNESS_COMMUNICATION_DELEGATION_TTL_SECONDS=86400

# Optional shared fixed-window rate limiting. Use a dedicated Redis ACL user
# restricted to the safeharness:communication-rate:* key prefix.
# SAFEHARNESS_COMMUNICATION_RATE_LIMIT_REDIS_URL=rediss://communication-rate-user:secret@redis.internal:6379/0
SAFEHARNESS_COMMUNICATION_RATE_LIMIT_REQUESTS=120
SAFEHARNESS_COMMUNICATION_RATE_LIMIT_WINDOW_SECONDS=60

# Optional content-free OTLP traces and metrics. Standard OTEL_EXPORTER_OTLP_*
# variables configure endpoint, TLS, headers, and export intervals.
SAFEHARNESS_OTEL_ENABLED=false
SAFEHARNESS_OTEL_SERVICE_NAME=safeharness-agent-communication-gateway
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal:4318

# Run safeharness-communication-maintain with separate retention and reader
# database identities. Audit export requires an HTTPS append-only receiver.
# SAFEHARNESS_COMMUNICATION_RETENTION_DSN=postgresql://communication-retention:secret@db/safeharness?sslmode=verify-full
# SAFEHARNESS_COMMUNICATION_READER_DSN=postgresql://communication-reader:secret@db/safeharness?sslmode=verify-full
SAFEHARNESS_COMMUNICATION_RETENTION_HOURS=168
SAFEHARNESS_COMMUNICATION_MAINTENANCE_INTERVAL=300
# SAFEHARNESS_COMMUNICATION_AUDIT_EXPORT_URL=https://audit-receiver.internal/v1/communication
# SAFEHARNESS_COMMUNICATION_AUDIT_EXPORT_TOKEN=replace-with-independent-token-at-least-32-chars
SAFEHARNESS_COMMUNICATION_AUDIT_CURSOR_FILE=data/communication-audit-export.cursor.json

# Optional alternate paths for the gateway and combined demo processes.
# SAFEHARNESS_COMMUNICATION_GATEWAY_ENV_FILE=C:/secure/communication-gateway.env
# SAFEHARNESS_COMMUNICATION_CLIENT_ENV_FILE=C:/secure/communication-clients.env

# Production traffic requires TLS. Set CLIENT_CA and REQUIRE_MTLS for client
# certificate authentication in addition to the per-Agent API keys.
# SAFEHARNESS_COMMUNICATION_TLS_CERT=C:/secure/communication-server-cert.pem
# SAFEHARNESS_COMMUNICATION_TLS_KEY=C:/secure/communication-server-key.pem
# SAFEHARNESS_COMMUNICATION_CLIENT_CA=C:/secure/workload-ca.pem
# SAFEHARNESS_COMMUNICATION_REQUIRE_MTLS=true
# SAFEHARNESS_COMMUNICATION_CA=C:/secure/workload-ca.pem
# SAFEHARNESS_COMMUNICATION_CLIENT_CERT=C:/secure/demo-client-cert.pem
# SAFEHARNESS_COMMUNICATION_CLIENT_KEY=C:/secure/demo-client-key.pem
