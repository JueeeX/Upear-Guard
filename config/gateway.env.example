# Copy to config/gateway.env. Do not load this gateway-only file into an Agent.
SAFEHARNESS_TOOL_GATEWAY_API_KEY=replace-with-at-least-32-random-characters
SAFEHARNESS_TOOL_GATEWAY_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Separate control-plane proof. HMAC is the compatibility mode; both processes
# need this key, so do not use it as the production trust boundary.
# Do not put the capability key above in the Agent process.
SAFEHARNESS_ENFORCEMENT_RECEIPT_MODE=hmac
SAFEHARNESS_ENFORCEMENT_RECEIPT_SIGNING_KEY=replace-with-another-32-random-bytes
#
# Recommended asymmetric gateway mode. Comment out the HMAC key above. This
# process receives public verification material only and rejects a private-key
# variable at startup.
# SAFEHARNESS_ENFORCEMENT_RECEIPT_MODE=ed25519
# SAFEHARNESS_ENFORCEMENT_RECEIPT_KEY_ID=noc-control-plane-2026-07
# SAFEHARNESS_ENFORCEMENT_RECEIPT_PUBLIC_KEY_FILE=C:/secure/receipt-public.pem
# SAFEHARNESS_ENFORCEMENT_RECEIPT_ISSUER=safeharness-control-plane
# For key rotation, replace the two singular settings with one JSON mapping:
# SAFEHARNESS_ENFORCEMENT_RECEIPT_PUBLIC_KEY_FILES={"noc-control-plane-2026-07":"C:/secure/receipt-2026-07-public.pem","noc-control-plane-2026-06":"C:/secure/receipt-2026-06-public.pem"}
SAFEHARNESS_REQUIRE_ENFORCEMENT_RECEIPT=false
SAFEHARNESS_TOOL_GATEWAY_HOST=127.0.0.1
SAFEHARNESS_TOOL_GATEWAY_PORT=38100
SAFEHARNESS_TOOL_GATEWAY_TENANT_ID=fiberhome-demo
SAFEHARNESS_TOOL_GATEWAY_AGENT_ID=noc-operator-agent
SAFEHARNESS_TOOL_GATEWAY_DATABASE=data/tool-gateway.sqlite3

# Single-node defaults. For multiple gateway replicas, use redis + postgres.
SAFEHARNESS_TOOL_GATEWAY_REPLAY_BACKEND=sqlite
SAFEHARNESS_TOOL_GATEWAY_AUDIT_BACKEND=sqlite

# Production examples. Supply credentials through a secret manager, not source.
# SAFEHARNESS_TOOL_GATEWAY_REDIS_URL=rediss://gateway-user:secret@redis.internal:6379/0
# SAFEHARNESS_TOOL_GATEWAY_REDIS_KEY_PREFIX=safeharness:capability-replay:
# SAFEHARNESS_TOOL_GATEWAY_REDIS_RECEIPT_KEY_PREFIX=safeharness:receipt-replay:
# SAFEHARNESS_TOOL_GATEWAY_POSTGRES_DSN=postgresql://gateway_writer:secret@postgres.internal/safeharness?sslmode=verify-full
# SAFEHARNESS_TOOL_GATEWAY_POSTGRES_TABLE=safeharness_audit_records
# Migration process only: optionally install least-privilege grants for these
# existing roles, then remove these variables from the runtime environment.
# SAFEHARNESS_TOOL_GATEWAY_POSTGRES_RUNTIME_ROLE=safeharness_writer
# SAFEHARNESS_TOOL_GATEWAY_POSTGRES_READER_ROLE=safeharness_reader

# Optional content-free OTLP traces and metrics. Standard OTEL_EXPORTER_OTLP_*
# variables configure endpoint, TLS, headers, and export intervals.
SAFEHARNESS_OTEL_ENABLED=false
SAFEHARNESS_OTEL_SERVICE_NAME=safeharness-tool-gateway
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal:4318

# Optional alternate gateway-only dotenv path.
# SAFEHARNESS_TOOL_GATEWAY_ENV_FILE=C:/secure/safeharness-gateway.env

# Optional TLS/mTLS. Strict mTLS accepts one verified SPIFFE URI SAN and binds
# it to SAFEHARNESS_TOOL_GATEWAY_WORKLOAD_ID; HTTP headers are never trusted.
# SAFEHARNESS_TOOL_GATEWAY_TLS_CERT=C:/secure/gateway-cert.pem
# SAFEHARNESS_TOOL_GATEWAY_TLS_KEY=C:/secure/gateway-key.pem
# SAFEHARNESS_TOOL_GATEWAY_CLIENT_CA=C:/secure/workload-ca.pem
# SAFEHARNESS_REQUIRE_MTLS=false
# SAFEHARNESS_TOOL_GATEWAY_WORKLOAD_ID=spiffe://fiberhome/safeharness/noc-agent

# Add real NMS credentials here only after replacing the simulated executors.
# NMS_BASE_URL=https://nms.internal.example
# NMS_API_KEY=replace-with-secret-manager-injection
