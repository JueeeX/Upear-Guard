{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(safeharness_gateway_http_requests_total[5m]))", "refId": "A"}],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(safeharness_gateway_http_requests_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(safeharness_gateway_http_requests_total[5m])), 0.001)", "refId": "A"}],
      "title": "5xx ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(safeharness_gateway_http_duration_milliseconds_bucket[5m])))", "refId": "A"}],
      "title": "P95 latency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (error_type) (rate(safeharness_gateway_http_requests_total{error_type!=\"\"}[5m]))", "legendFormat": "{{error_type}}", "refId": "A"}],
      "title": "SafeHarness error codes",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["safeharness", "gateway"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "SafeHarness Tool Gateway",
  "uid": "safeharness-tool-gateway",
  "version": 1
